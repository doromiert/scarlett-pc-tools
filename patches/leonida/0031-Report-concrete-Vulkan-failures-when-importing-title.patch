From a3335810813d48a00e7625850b44cf6bffecf3fd Mon Sep 17 00:00:00 2001
From: doromiert <doromiert@gmail.com>
Date: Mon, 23 Nov 2026 17:36:41 +0100
Subject: [PATCH 31/33] Report concrete Vulkan failures when importing title
 memory

---
 runtime/shims/d3d12_vulkan_device.cpp | 24 +++++++++++++++++++++---
 1 file changed, 21 insertions(+), 3 deletions(-)

diff --git a/runtime/shims/d3d12_vulkan_device.cpp b/runtime/shims/d3d12_vulkan_device.cpp
index f7e405d97..e493907d4 100644
--- a/runtime/shims/d3d12_vulkan_device.cpp
+++ b/runtime/shims/d3d12_vulkan_device.cpp
@@ -1891,6 +1891,11 @@ public:
     // docs/d3d12_vulkan.md section 3.3, which this does not decide. The pages stay the caller's: nothing is zeroed.
     HRESULT create_host_buffer(void* address) {
         auto& vk = device_.context->vk;
+        MEMORY_BASIC_INFORMATION cpu{};
+        VirtualQuery(address, &cpu, sizeof(cpu));
+        std::fprintf(stderr, "[rt] host import: width=%llu CPU state=0x%lx protection=0x%lx region=%llu\n",
+                     static_cast<unsigned long long>(desc_.Width), cpu.State, cpu.Protect,
+                     static_cast<unsigned long long>(cpu.RegionSize));
         const VkDeviceSize alignment = device_.info.host_pointer_alignment;
         if (!device_.get_host_pointer_properties || !alignment) return E_NOTIMPL;
         const auto start = reinterpret_cast<std::uintptr_t>(address);
@@ -1909,7 +1914,11 @@ public:
         if (device_.info.conditional_rendering) info.usage |= VK_BUFFER_USAGE_CONDITIONAL_RENDERING_BIT_EXT;
         if (need_bda) info.usage |= VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT;
         device_.share(info);
-        if (vk.vkCreateBuffer(device_.info.device, &info, nullptr, &buffer_) != VK_SUCCESS) return E_OUTOFMEMORY;
+        const VkResult create_result = vk.vkCreateBuffer(device_.info.device, &info, nullptr, &buffer_);
+        if (create_result != VK_SUCCESS) {
+            std::fprintf(stderr, "[rt] host import: vkCreateBuffer failed (%d)\n", int(create_result));
+            return E_OUTOFMEMORY;
+        }
         VkMemoryRequirements requirements{};
         vk.vkGetBufferMemoryRequirements(device_.info.device, buffer_, &requirements);
         VkMemoryHostPointerPropertiesEXT host{VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT};
@@ -1935,7 +1944,12 @@ public:
                                               need_bda ? static_cast<const void*>(&flags) : &import};
                 allocate.allocationSize = bytes;
                 allocate.memoryTypeIndex = i;
-                if (vk.vkAllocateMemory(device_.info.device, &allocate, nullptr, &memory_) == VK_SUCCESS)
+                const VkResult allocation_result = vk.vkAllocateMemory(device_.info.device, &allocate, nullptr, &memory_);
+                if (allocation_result != VK_SUCCESS)
+                    std::fprintf(stderr, "[rt] host import: vkAllocateMemory failed (%d), type=%u flags=0x%x bytes=%llu\n",
+                                 int(allocation_result), i, device_.memory.memoryTypes[i].propertyFlags,
+                                 static_cast<unsigned long long>(bytes));
+                if (allocation_result == VK_SUCCESS)
                     memory_flags_ = device_.memory.memoryTypes[i].propertyFlags;
                 else
                     memory_ = VK_NULL_HANDLE;
@@ -1943,7 +1957,11 @@ public:
             if (memory_) break;
         }
         if (!memory_) return E_OUTOFMEMORY;
-        if (vk.vkBindBufferMemory(device_.info.device, buffer_, memory_, 0) != VK_SUCCESS) return E_OUTOFMEMORY;
+        const VkResult bind_result = vk.vkBindBufferMemory(device_.info.device, buffer_, memory_, 0);
+        if (bind_result != VK_SUCCESS) {
+            std::fprintf(stderr, "[rt] host import: vkBindBufferMemory failed (%d)\n", int(bind_result));
+            return E_OUTOFMEMORY;
+        }
         mapped_ = address;
         va_ = start;
         if (need_bda && vk.vkGetBufferDeviceAddress) {
