+            "buffer_store_dword v11, v17, s[0:3], 0 offen",
+            "v_add_nc_u32_e32 v17, 4, v17",
+            "buffer_store_dword v12, v17, s[0:3], 0 offen",
+            "v_add_nc_u32_e32 v17, 4, v17",
