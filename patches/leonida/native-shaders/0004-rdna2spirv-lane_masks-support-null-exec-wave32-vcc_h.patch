+            "v_add_nc_u32_e32 v17, 4, v17",
+            "buffer_store_dword v14, v17, s[0:3], 0 offen",
+            "v_add_nc_u32_e32 v17, 4, v17",
+            "buffer_store_dword v15, v17, s[0:3], 0 offen",
+            "v_add_nc_u32_e32 v17, 4, v17",
+            "buffer_store_dword v16, v17, s[0:3], 0 offen",
