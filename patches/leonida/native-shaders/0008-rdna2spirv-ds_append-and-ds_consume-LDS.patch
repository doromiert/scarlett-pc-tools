+ds_read_b32 v12, v1 offset:8
+s_waitcnt lgkmcnt(0)
+s_mov_b32 exec_lo, -1
+ds_append v10
+s_waitcnt lgkmcnt(0)
+ds_read_b32 v13, v1
+s_waitcnt lgkmcnt(0)
+v_readlane_b32 s20, v8, 4
+v_readlane_b32 s21, v8, 0
+v_readlane_b32 s22, v9, 2
+v_readlane_b32 s23, v9, 3
