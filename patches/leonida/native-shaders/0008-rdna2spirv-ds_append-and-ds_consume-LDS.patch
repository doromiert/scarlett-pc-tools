+;   EXEC = lanes 0, 32, 63:   ds_append v8          -> v8 = 100 in those lanes;       LDS[0] = 103
+;   EXEC = lane 33:           ds_consume v9 offset:8 -> v9 = 200 in lane 33;          LDS[2] = 199
