From d6ee0bbf018b13dbc806b161351243bd90de9d1d Mon Sep 17 00:00:00 2001
From: doromiert <doromiert@gmail.com>
Date: Mon, 23 Nov 2026 20:53:39 +0100
Subject: [PATCH 10/15] Adapt PR8842 wave64 VCC bit replication without
 overriding dispatch wave size

Based on74859f4dab3a5245f0ef35d50d4803b008629cb5 by Andreev Kirill Andreevich. Retains the known wave64-only target and upstream per-lane formula; excludes the opcode-based wave-size heuristic.
---
 docs/design.md      | 5 +++++
 tools/lane_masks.py | 2 ++
 tools/rdna2spirv.py | 7 +++++--
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/docs/design.md b/docs/design.md
index c6a51b331..ac1d5563c 100644
--- a/docs/design.md
+++ b/docs/design.md
@@ -657,3 +657,8 @@ noperspective on SV_Position), flat otherwise. Synthetic tests: `tests/test_ps_i
   `xmem.dll` imports and two `d3d12_xs.dll` root-signature calls bind to shims. Every other import resolves on
   desktop Windows. The proxy covers the measured device slots and forwards the rest in PC vtable order; the Xbox
   queue/fence/command-list extensions and `PresentX` remain unknown.
+
+Local integration note: the wave64 VCC destination of `s_bitreplicate_b64_b32` is
+lowered with the per-lane rule from PR 8842 (Andreev Kirill Andreevich), while
+keeping the dispatch state's wave size authoritative and refusing wave32 VCC.
+This subset does not infer wave64 from the opcode's 64-bit destination alone.
diff --git a/tools/lane_masks.py b/tools/lane_masks.py
index db1fc8047..ec34816a1 100644
--- a/tools/lane_masks.py
+++ b/tools/lane_masks.py
@@ -220,6 +220,8 @@ def step(state, ins, wave64=True):
         # In wave32 code it is 64-bit data, e.g. the first two words of an S# built in place (the pipeline library's
         # wave32 compute programs: s_bfm_b64 s[88:89], 2, 54); rdna2spirv computes the value there.
         put(state, a[0], MASK if wave64 else None, wave64)
+    elif op == "s_bitreplicate_b64_b32" and wave64 and a[0].get("t") == "vcc":
+        put(state, a[0], MASK, wave64)
     elif op.startswith(COPIES) and len(a) > 1:
         k = kind(state, a[1], wave64)
         dst_t = a[0].get("t") if a[0]["k"] == "special" else None
diff --git a/tools/rdna2spirv.py b/tools/rdna2spirv.py
index 7f35a6579..1a63e7de4 100644
--- a/tools/rdna2spirv.py
+++ b/tools/rdna2spirv.py
@@ -6869,7 +6869,7 @@ class Gen:
             if self.is_mask_op(x):
                 raise Unsupported(op + " on a lane mask")
             if d["k"] == "special" and d.get("t", "").startswith(("exec", "vcc")):
-                if op != "s_bitreplicate_b64_b32" or d["t"] != "exec":
+                if op != "s_bitreplicate_b64_b32" or (d["t"] != "exec" and not (self.wave64 and d["t"] == "vcc")):
                     raise Unsupported(op + " on a lane mask")
                 # EXEC's bit for lane L comes from scalar-source bit L // 2.
                 shift, shifted, bit = (self.tmp() for _ in range(3))
@@ -6878,7 +6878,10 @@ class Gen:
                 self.emit(f"{shift} = OpShiftRightLogical %uint {lane} {self.cu(1)}")
                 self.emit(f"{shifted} = OpShiftRightLogical %uint {word} {shift}")
                 self.emit(f"{bit} = OpBitwiseAnd %uint {shifted} {self.cu(1)}")
-                self.set_exec(bit)
+                if d["t"] == "exec":
+                    self.set_exec(bit)
+                else:
+                    self.emit(f"OpStore %vcc {bit}")
                 return
             if wide_src:
                 lo, hi = self.src64_data(x, op)
-- 
2.54.0

