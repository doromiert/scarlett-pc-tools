From 68425dcea43915bb4b5a95da84bd08e1841122ef Mon Sep 17 00:00:00 2001
From: P2GR <26923358+P2GR@users.noreply.github.com>
Date: Mon, 23 Nov 2026 17:59:05 +0100
Subject: [PATCH 18/19] d3d12: checkpoint slow compute pipeline compiles

Depends on: #7384
AI-assisted: yes (Codex)
---
 docs/d3d12_vulkan.md                  |  3 +++
 runtime/shims/d3d12_vulkan_device.cpp | 31 +++++++++++++++++++++------
 2 files changed, 28 insertions(+), 6 deletions(-)

diff --git a/docs/d3d12_vulkan.md b/docs/d3d12_vulkan.md
index 0eb1ce102..e49026d74 100644
--- a/docs/d3d12_vulkan.md
+++ b/docs/d3d12_vulkan.md
@@ -2067,6 +2067,9 @@ Pipeline creation:
   (`LEONIDA_PIPELINE_CACHE_BYTES=<bytes>`, `0` turns it off): a cache seeded with the corpus file returns the whole
   union, which is not worth rewriting at every exit. A session file from another device, driver or pipeline-cache
   UUID is ignored with one line, and a write that fails (a read-only install directory) leaves the previous file.
+  Set `LEONIDA_STARTUP_CACHE_CHECKPOINTS=1` to write the session file after a successful compute pipeline
+  compile that took at least 500 ms. A later launch can reuse the completed work if the process exits before device
+  teardown. The session file keeps the same size cap and atomic replacement.
   `GetCachedBlob` records the vendor, device, driver version, `pipelineCacheUUID` and a SHA-256 of the description
   without `Flags`, sealed by a checksum (`runtime/src/cached_pso.h`). The answers are the host's, measured on an
   RTX 3060 and WARP: the same description is accepted; another
diff --git a/runtime/shims/d3d12_vulkan_device.cpp b/runtime/shims/d3d12_vulkan_device.cpp
index df1b5ec7a..7c126d4e6 100644
--- a/runtime/shims/d3d12_vulkan_device.cpp
+++ b/runtime/shims/d3d12_vulkan_device.cpp
@@ -283,9 +283,15 @@ void merge_session_pipeline_cache(const leonida::VulkanDeviceFunctions& vk, VkDe
                      static_cast<int>(result));
 }
 
-// Writes what this device compiled for the next launch (D3D-704). Called once the device is idle, before the cache
-// is destroyed. Past the cap nothing is written: the blob from an earlier, smaller session stays, which is better
-// than replacing it with one the next launch would keep refusing to save.
+bool startup_cache_checkpoints_enabled() {
+    static const bool enabled = [] {
+        wchar_t value[2]{};
+        return GetEnvironmentVariableW(L"LEONIDA_STARTUP_CACHE_CHECKPOINTS", value, 2) == 1 && value[0] == L'1';
+    }();
+    return enabled;
+}
+
+// Writes the session cache at a startup checkpoint or during device teardown. The size cap applies to either write.
 void save_session_pipeline_cache(const leonida::VulkanDeviceFunctions& vk, VkDevice device, VkPipelineCache cache) {
     if (!cache || !vk.vkGetPipelineCacheData) return;
     const std::size_t limit = pipeline_cache_save_limit();
@@ -306,8 +312,7 @@ void save_session_pipeline_cache(const leonida::VulkanDeviceFunctions& vk, VkDev
     }
     std::vector<char> data;
     try {
-        // Room to spare in case the driver counts the blob short between the query and the read. Nothing creates
-        // pipelines while the device is torn down, so this is a belt-and-braces margin, not a retry loop.
+        // Leave room in case another thread grows the cache between the size query and the read.
         data.resize(size + (size >> 4));
     } catch (const std::bad_alloc&) {
         std::fprintf(stderr,
@@ -763,6 +768,7 @@ struct DeviceState {
     leonida::cached_pso::Identity pso_identity;  // what GetCachedBlob records and CachedPSO is checked against
     std::once_flag pipeline_cache_once;
     VkPipelineCache pipeline_cache_handle = VK_NULL_HANDLE;
+    std::mutex startup_cache_checkpoint_mutex;
 
     VkPipelineCache pipeline_cache() {
         std::call_once(pipeline_cache_once, [this] {
@@ -4178,15 +4184,28 @@ public:
         VkPipelineShaderStageRequiredSubgroupSizeCreateInfo required_size{};
         subgroup_size_for(*entry, required_size, pipeline_info.stage);
         pipeline_info.layout = pipeline_.layout;
+        const VkPipelineCache cache = device_.pipeline_cache();
+        const bool checkpoint = cache && startup_cache_checkpoints_enabled();
+        const ULONGLONG started = checkpoint ? GetTickCount64() : 0;
         VkResult created = VK_ERROR_UNKNOWN;
         {
             // The console makes this pipeline from native code at once; the driver's compile of the translated module
             // is host-only time on the title's thread, which a guest Sleep sits out (src/host_stall.h).
             const rt::host_stall::Scope compiling;
-            created = vk.vkCreateComputePipelines(dev, device_.pipeline_cache(), 1, &pipeline_info, nullptr,
+            created = vk.vkCreateComputePipelines(dev, cache, 1, &pipeline_info, nullptr,
                                                   &pipeline_.pipeline);
         }
         if (created != VK_SUCCESS) return E_FAIL;
+        if (checkpoint && GetTickCount64() - started >= 500) {
+            const std::unique_lock lock(device_.startup_cache_checkpoint_mutex, std::try_to_lock);
+            if (lock.owns_lock()) {
+                try {
+                    save_session_pipeline_cache(vk, dev, cache);
+                } catch (const std::exception& error) {
+                    std::fprintf(stderr, "[rt] d3d12: pipeline cache checkpoint failed (%s)\n", error.what());
+                }
+            }
+        }
 
         // The code base: shaders read constant tables embedded in their own program through s_getpc_b64. The
         // translator's code offsets are into the bytes the key hashes (the FSSM blob, or the kind-6 program).
