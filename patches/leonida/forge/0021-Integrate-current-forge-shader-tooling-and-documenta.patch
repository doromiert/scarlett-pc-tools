+                        tmpl.format(dst=exec_reg),
+                        "v_mov_b32_e32 v11, 0xAAAAAAAA",
+                        mov_exec,
+                        f"v_cndmask_b32_e64 v12, 0x10101010, 0x20202020, {vcc_reg}",
+                        "v_lshlrev_b32_e32 v14, 3, v0",
+                        "v_add_nc_u32_e32 v15, 4, v14",
