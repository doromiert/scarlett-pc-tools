+// Opt-in bound for the actual graphics compile phase; zero/unset retains the existing concurrency.
+class GraphicsCompileSlot {
+    struct State {
+        std::mutex mutex;
+        std::condition_variable changed;
+        unsigned active = 0;
+        const unsigned limit = [] {
+            char text[16]{};
+            const DWORD size = GetEnvironmentVariableA("LEONIDA_GRAPHICS_PIPELINE_THREADS", text, sizeof(text));
+            if (!size) return 0u;
+            if (size >= sizeof(text)) {
+                std::fprintf(stderr, "[rt] invalid LEONIDA_GRAPHICS_PIPELINE_THREADS; graphics concurrency unchanged\n");
+                return 0u;
+            }
+            char* end = nullptr;
+            const unsigned long value = std::strtoul(text, &end, 10);
+            if (!end || *end || value > 64) {
+                std::fprintf(stderr, "[rt] invalid LEONIDA_GRAPHICS_PIPELINE_THREADS; graphics concurrency unchanged\n");
+                return 0u;
+            }
+            if (value) std::fprintf(stderr, "[rt] graphics pipeline compile concurrency limited to %lu\n", value);
+            return static_cast<unsigned>(value);
+        }();
+    };
+    static State& state() { static State value; return value; }
+    State* held_ = nullptr;
+public:
+    GraphicsCompileSlot() {
+        auto& value = state();
+        if (!value.limit) return;
+        std::unique_lock lock(value.mutex);
+        value.changed.wait(lock, [&] { return value.active < value.limit; });
+        ++value.active;
+        held_ = &value;
+    }
+    ~GraphicsCompileSlot() {
+        if (!held_) return;
+        { const std::lock_guard lock(held_->mutex); --held_->active; }
+        held_->changed.notify_one();
+    }
+    GraphicsCompileSlot(const GraphicsCompileSlot&) = delete;
+    GraphicsCompileSlot& operator=(const GraphicsCompileSlot&) = delete;
+};
+
 bool startup_cache_checkpoints_enabled() {
     static const bool enabled = [] {
         wchar_t value[2]{};
@@ -4509,12 +4554,11 @@ private:
         if (call <= 8 || call % 128 == 0)
             std::fprintf(stderr, "[rt] graphics pipeline compile started: call=%llu stages=%u\n",
                          static_cast<unsigned long long>(call), info.stageCount);
-        VkResult result = VK_ERROR_UNKNOWN;
-        {
-            const rt::host_stall::Scope compiling;  // host-only time a guest Sleep sits out, as for compute (slot 57)
-            result = device_.context->vk.vkCreateGraphicsPipelines(device_.info.device, cache, 1,
-                                                                    &info, nullptr, &pipeline);
-        }
+        // Also bound the checkpoint's scratch allocation, and keep all host-only waiting outside guest Sleep time.
+        const rt::host_stall::Scope compiling;
+        const GraphicsCompileSlot slot;
+        const VkResult result = device_.context->vk.vkCreateGraphicsPipelines(device_.info.device, cache, 1,
+                                                                               &info, nullptr, &pipeline);
         rt::d3d12_xs::report_graphics_pipeline_finished(result == VK_SUCCESS);
         if (call <= 8 || call % 128 == 0 || result != VK_SUCCESS)
             std::fprintf(stderr, "[rt] graphics pipeline compile finished: call=%llu result=%d duration_ms=%llu\n",
