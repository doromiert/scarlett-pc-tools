+void present_window_thread(PresentState* state) {
+    WNDCLASSW window_class{};
+    window_class.lpfnWndProc = present_window_proc;
+    window_class.hInstance = GetModuleHandleW(nullptr);
+    window_class.lpszClassName = L"LeonidaPresentX";
+    if (!RegisterClassW(&window_class) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS) {
+        std::fprintf(stderr, "[rt] d3d12_xs: PresentX window class failed (error %lu)\n", GetLastError());
+        {
+            std::lock_guard lock(state->window_mutex);
+            state->window_started = true;
+        }
+        state->window_ready.notify_one();
+        return;
+    }
+
+    RECT work_area{0, 0, GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN)};
+    POINT cursor{};
+    MONITORINFO monitor_info{};
+    monitor_info.cbSize = sizeof(monitor_info);
+    if (GetCursorPos(&cursor) &&
+        GetMonitorInfoW(MonitorFromPoint(cursor, MONITOR_DEFAULTTOPRIMARY), &monitor_info))
+        work_area = monitor_info.rcWork;
+
+    constexpr LONG target_width = 1280;
+    constexpr LONG target_height = 720;
+    constexpr DWORD style = WS_OVERLAPPEDWINDOW | WS_VISIBLE;
+    RECT target_outer{0, 0, target_width, target_height};
+    AdjustWindowRectEx(&target_outer, style, FALSE, 0);
+    const LONG border_width = target_outer.right - target_outer.left - target_width;
+    const LONG border_height = target_outer.bottom - target_outer.top - target_height;
+    const LONG available_width = (std::max)(1L, work_area.right - work_area.left - border_width);
+    const LONG available_height = (std::max)(1L, work_area.bottom - work_area.top - border_height);
+    LONG client_width = (std::min)(target_width, available_width);
+    LONG client_height = client_width * 9 / 16;
+    if (client_height > available_height) {
+        client_height = (std::min)(target_height, available_height);
+        client_width = (std::max)(1L, client_height * 16 / 9);
+    }
+
+    RECT outer{0, 0, client_width, client_height};
+    AdjustWindowRectEx(&outer, style, FALSE, 0);
+    const LONG outer_width = outer.right - outer.left;
+    const LONG outer_height = outer.bottom - outer.top;
+    const int x = work_area.left + (work_area.right - work_area.left - outer_width) / 2;
+    const int y = work_area.top + (work_area.bottom - work_area.top - outer_height) / 2;
+    HWND window = CreateWindowExW(0, window_class.lpszClassName, L"Leonida", style, x, y, outer_width, outer_height,
+                                  nullptr, nullptr, window_class.hInstance, state);
+    if (!window)
+        std::fprintf(stderr, "[rt] d3d12_xs: PresentX window failed (error %lu)\n", GetLastError());
+    {
+        std::lock_guard lock(state->window_mutex);
+        state->window = window;
+        state->window_started = true;
+    }
+    state->window_ready.notify_one();
+    if (!window) return;
+
+    UpdateWindow(window);
+    MSG message{};
+    while (GetMessageW(&message, nullptr, 0, 0) > 0) {
+        TranslateMessage(&message);
+        DispatchMessageW(&message);
+    }
+}
