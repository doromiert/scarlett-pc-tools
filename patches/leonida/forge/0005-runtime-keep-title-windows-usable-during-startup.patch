+++ b/runtime/shims/title_window.cpp
@@ -0,0 +1,56 @@
+// Keeps explicitly sized title windows usable on the monitor they target. The mapped title imports this API-set
+// entry through the shim registry; the runtime's own windows still call user32 directly.
+#include "shims.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+
+namespace {
+
+HWND WINAPI create_window_ex_a(DWORD ex_style, LPCSTR class_name, LPCSTR window_name, DWORD style, int x, int y,
+                               int width, int height, HWND parent, HMENU menu, HINSTANCE instance, LPVOID param) {
+    const bool uses_default = x == CW_USEDEFAULT || y == CW_USEDEFAULT || width == CW_USEDEFAULT ||
+                              height == CW_USEDEFAULT;
+    if ((style & WS_CHILD) || parent == HWND_MESSAGE || uses_default || width <= 0 || height <= 0)
+        return CreateWindowExA(ex_style, class_name, window_name, style, x, y, width, height, parent, menu, instance,
+                               param);
+
+    RECT requested{x, y, x + width, y + height};
+    MONITORINFO monitor{};
+    monitor.cbSize = sizeof(monitor);
+    if (!GetMonitorInfoW(MonitorFromRect(&requested, MONITOR_DEFAULTTONEAREST), &monitor))
+        return CreateWindowExA(ex_style, class_name, window_name, style, x, y, width, height, parent, menu, instance,
+                               param);
+
+    const int work_width = monitor.rcWork.right - monitor.rcWork.left;
+    const int work_height = monitor.rcWork.bottom - monitor.rcWork.top;
+    if (width <= work_width && height <= work_height)
+        return CreateWindowExA(ex_style, class_name, window_name, style, x, y, width, height, parent, menu, instance,
+                               param);
+
+    // CreateWindowEx dimensions already include the non-client border: scale the complete outer window to fit.
+    std::int64_t scale_num = work_width;
+    std::int64_t scale_den = width;
+    if (std::int64_t(height) * scale_num > std::int64_t(work_height) * scale_den) {
+        scale_num = work_height;
+        scale_den = height;
+    }
+    const int fitted_width = (std::max)(1, static_cast<int>(std::int64_t(width) * scale_num / scale_den));
+    const int fitted_height = (std::max)(1, static_cast<int>(std::int64_t(height) * scale_num / scale_den));
+    const int fitted_x = monitor.rcWork.left + (work_width - fitted_width) / 2;
+    const int fitted_y = monitor.rcWork.top + (work_height - fitted_height) / 2;
+    std::fprintf(stderr, "[rt] window: fit oversized title window %dx%d to %dx%d at %d,%d\n", width, height,
+                 fitted_width, fitted_height, fitted_x, fitted_y);
+    return CreateWindowExA(ex_style, class_name, window_name, style, fitted_x, fitted_y, fitted_width, fitted_height,
+                           parent, menu, instance, param);
+}
+
+}  // namespace
+
+SHIM_TABLE(title_window,
+    {"ext-ms-win-rtcore-ntuser-window-ansi-l1-1-0.dll", "CreateWindowExA",
+     reinterpret_cast<void*>(&create_window_ex_a)},
+);
