+void PresentState::post_destroy_window() {
+    std::lock_guard lock(window_mutex);
+    if (window) PostMessageW(window, kDestroyWindowMessage, 0, 0);
+}
+
+PresentState::~PresentState() {
+    xbox.reset();  // release the Vulkan surface before asking its owner thread to destroy the HWND
+    post_destroy_window();
+    if (window_thread.joinable()) window_thread.join();
+}
+
+void PresentState::finish_close() {
+    if (!close_requested.exchange(false)) return;
+    xbox.reset();
+    post_destroy_window();
+}
