+    title_heaps: Vec<usize>,
     topology: Option<u32>,
     viewports: Vec<D3D12_VIEWPORT>,
     scissors: Vec<windows::Win32::Foundation::RECT>,
@@ -275,13 +278,17 @@ pub(super) fn pc_va_of(va: u64) -> u64 {
 
 fn retained_heaps(list: *mut c_void) -> Vec<usize> {
     LISTS.lock().unwrap().as_ref().and_then(|m| m.get(&(list as usize)))
-        .map(|s| s.bindings.heaps.clone()).unwrap_or_default()
+        .map(|s| if s.bindings.title_heaps.is_empty() { s.bindings.heaps.clone() } else { s.bindings.title_heaps.clone() }).unwrap_or_default()
 }
 
 /// Only an unambiguous, already-bound sampler heap can supply an experimental base.
 pub(super) fn bound_sampler_shadow(list: *mut c_void) -> Option<(usize, u32)> {
+    bound_heap_shadow(list, true)
+}
+
+pub(super) fn bound_heap_shadow(list: *mut c_void, sampler: bool) -> Option<(usize, u32)> {
     let mut heaps: Vec<_> = retained_heaps(list).into_iter()
-        .filter_map(super::console_heap::sampler_shadow_for_pc).filter(|(_, n)| *n != 0).collect();
+        .filter_map(|heap| super::console_heap::heap_shadow_for_pc(heap, sampler)).filter(|(_, n)| *n != 0).collect();
     heaps.sort_unstable();heaps.dedup();
     (heaps.len() == 1).then(|| heaps[0])
 }
@@ -1751,6 +1758,8 @@ pub(super) unsafe fn pc_heaps(n: u32, heaps: *const usize) -> Vec<Option<ID3D12D
 pub(super) unsafe extern "system" fn set_descriptor_heaps_x(this: *mut c_void, n: u32, heaps: *const usize) {
     const PC_SET_DESCRIPTOR_HEAPS: usize = 28;
     let f = pc::<unsafe extern "system" fn(*mut c_void, u32, *const usize)>(this, PC_SET_DESCRIPTOR_HEAPS);
+    let given = if heaps.is_null() { Vec::new() } else { std::slice::from_raw_parts(heaps, n as usize).to_vec() };
+    with_bindings(this, |b| b.title_heaps = given);
     if heaps.is_null() || super::console_heap::global_heap().is_none() {
         if !heaps.is_null() {
             let given = std::slice::from_raw_parts(heaps, n as usize).to_vec();
