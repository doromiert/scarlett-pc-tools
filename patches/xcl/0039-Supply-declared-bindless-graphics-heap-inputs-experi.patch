From: doromiert <doromiert@gmail.com>
Date: Tue, 24 Nov 2026 03:15:25 +0100
Subject: [PATCH 39/41] Supply declared bindless graphics heap inputs
 experimentally

---
 crates/xcl/src/hle/d3d12x/bind.rs         | 29 ++++++++++++++++++++++-
 crates/xcl/src/hle/d3d12x/console_heap.rs |  6 ++++-
 crates/xcl/src/hle/d3d12x/console_list.rs |  3 ++-
 crates/xcl/src/hle/d3d12x/list_x.rs       | 13 ++++++++--
 4 files changed, 46 insertions(+), 5 deletions(-)

diff --git a/crates/xcl/src/hle/d3d12x/bind.rs b/crates/xcl/src/hle/d3d12x/bind.rs
index 64cbfb0..af22d72 100644
--- a/crates/xcl/src/hle/d3d12x/bind.rs
+++ b/crates/xcl/src/hle/d3d12x/bind.rs
@@ -847,8 +847,35 @@ unsafe fn bind_abi(this: *mut c_void, list: &ID3D12GraphicsCommandList, pso: usi
     // Default-off ABI experiment. The explicitly requested register must be the
     // first unused inline register, so no supplied title root argument is replaced.
     // The heap and address are derived from current bindings, never fixed payloads.
+    static BINDLESS_INPUTS: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    let bindless_inputs = *BINDLESS_INPUTS.get_or_init(|| std::env::var("XCL_BINDLESS_HEAP_INPUTS").as_deref() == Ok("1"));
+    if gfx && bindless_inputs {
+        if let Some(layout) = layout.as_ref().filter(|l| l.inline_gfx == l.size && args.len() >= l.size as usize && io.len() == 8 + l.inline_gfx as usize / 4 && l.flags & 0xc00 != 0) {
+            let inputs: Option<Vec<u32>> = [(0x400, false, 32usize), (0x800, true, 16)]
+                .into_iter().filter(|(flag, _, _)| layout.flags & flag != 0)
+                .map(|(_, sampler, stride)| {
+                    let (shadow, count) = super::list_x::bound_heap_shadow(this, sampler)?;
+                    let (base, size) = u.window(0);
+                    let offset = shadow.checked_sub(base)?;
+                    (offset.checked_add((count as usize).checked_mul(stride)?)? <= size)
+                        .then(|| u32::try_from(offset).ok()).flatten()
+                }).collect();
+            if let Some(inputs) = inputs.filter(|v| io.len() + v.len() <= 32) {
+                static N: AtomicU64 = AtomicU64::new(0);
+                if N.fetch_add(1, Ordering::Relaxed) < 16 {
+                    crate::xlog_info!("experimental bindless ABI: root flags {:#x}, s{} receives resource/sampler offsets {inputs:x?}", layout.flags, io.len());
+                }
+                io.extend(inputs);
+            } else {
+                static N: AtomicU64 = AtomicU64::new(0);
+                if N.fetch_add(1, Ordering::Relaxed) < 8 {
+                    crate::xlog_warn!("experimental bindless ABI: root flags {:#x} at s{} lack unambiguous in-window bound heap inputs", layout.flags, io.len());
+                }
+            }
+        }
+    }
     static SAMPLER_SLOT: std::sync::OnceLock<Option<usize>> = std::sync::OnceLock::new();
-    if gfx {
+    if gfx && !bindless_inputs {
         if let Some(slot) = *SAMPLER_SLOT.get_or_init(|| std::env::var("XCL_SAMPLER_BASE_SGPR").ok().and_then(|v| v.parse().ok())) {
             if slot == io.len() && (8..32).contains(&slot) {
                 if let Some((shadow, count)) = super::list_x::bound_sampler_shadow(this) {
diff --git a/crates/xcl/src/hle/d3d12x/console_heap.rs b/crates/xcl/src/hle/d3d12x/console_heap.rs
index 7cc97f8..90fa7ea 100644
--- a/crates/xcl/src/hle/d3d12x/console_heap.rs
+++ b/crates/xcl/src/hle/d3d12x/console_heap.rs
@@ -304,8 +304,12 @@ pub fn start(obj: usize) -> Option<u64> {
 /// Read-only identity lookup: the CPU shadow of a sampler heap already bound on a PC list.
 /// Drop the heap lock before normalizing native identities to preserve lock ordering.
 pub(super) fn sampler_shadow_for_pc(obj: usize) -> Option<(usize, u32)> {
+    heap_shadow_for_pc(obj, true)
+}
+
+pub(super) fn heap_shadow_for_pc(obj: usize, sampler: bool) -> Option<(usize, u32)> {
     let native = super::native_proxy::native(obj as *mut std::ffi::c_void) as usize;
-    let heaps: Vec<_> = HEAPS.lock().unwrap().iter().filter(|h| h.sampler)
+    let heaps: Vec<_> = HEAPS.lock().unwrap().iter().filter(|h| h.sampler == sampler && h.visible)
         .map(|h| (h.obj, h.shadow, h.n)).collect();
     heaps.into_iter().find_map(|(id, shadow, n)|
         (super::native_proxy::native(id as *mut std::ffi::c_void) as usize == native).then_some((shadow, n)))
