From: doromiert <doromiert@gmail.com>
Date: Mon, 23 Nov 2026 22:20:00 +0100
Subject: [PATCH] Unwrap resources passed to PC-only tile mapping queues

---
 crates/xcl/src/hle/d3d12x/native_proxy.rs | 13 +++++++++++++
 crates/xcl/src/hle/d3d12x/sparse.rs       |  6 ++++--
 crates/xcl/src/hle/d3d12x/vram.rs         |  3 ++-
 3 files changed, 19 insertions(+), 3 deletions(-)

diff --git a/crates/xcl/src/hle/d3d12x/native_proxy.rs b/crates/xcl/src/hle/d3d12x/native_proxy.rs
index a7bde94..b43fc1c 100644
--- a/crates/xcl/src/hle/d3d12x/native_proxy.rs
+++ b/crates/xcl/src/hle/d3d12x/native_proxy.rs
@@ -35,6 +35,19 @@ pub(super) unsafe fn kind(p: *mut c_void) -> Option<Kind> {
     (native(p) != p).then(|| proxy(p).kind)
 }
 
+/// PC-only queues were made before adoption and do not have the boundary vtable hooks.
+pub(super) unsafe fn resource_for_pc(resource: &ID3D12Resource, site: &str) -> ID3D12Resource {
+    let p = native(resource.as_raw());
+    if std::env::var_os("XCL_NATIVE_OBJECT_TRACE").is_some() {
+        static N: AtomicU32 = AtomicU32::new(0);
+        if N.fetch_add(1, Ordering::Relaxed) < 32 {
+            let v = *(p as *const usize);
+            crate::xlog_info!("D3D12.X: native resource at {site}: console {:p}, native {p:p}, vtable {v:#x} ({})", resource.as_raw(), crate::modules::describe_address(v));
+        }
+    }
+    ID3D12Resource::from_raw_borrowed(&p).unwrap().clone()
+}
+
 /// Take ownership of the reference returned by a native creator.
 pub(super) unsafe fn wrap(native: *mut c_void, kind: Kind) -> *mut c_void {
     if kind == Kind::Resource {
