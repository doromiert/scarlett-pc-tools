     let Some(list) = ID3D12GraphicsCommandList::from_raw_borrowed(&this) else { return };
     if !super::real::is_translated_compute(pso) {
         // a console pipeline without a translation (including a background build that
diff --git a/crates/xcl/src/hle/d3d12x/device_x.rs b/crates/xcl/src/hle/d3d12x/device_x.rs
index b52e8b5..10af69c 100644
--- a/crates/xcl/src/hle/d3d12x/device_x.rs
+++ b/crates/xcl/src/hle/d3d12x/device_x.rs
@@ -992,6 +992,7 @@ pub(super) unsafe extern "system" fn create_command_signature_x(this: *mut c_voi
     let n = u32::from_le_bytes(pc[4..8].try_into().unwrap()) as usize;
     let args = u64::from_le_bytes(pc[8..16].try_into().unwrap()) as *const [u32; 4];
     let mut list: Vec<[u32; 4]> = if args.is_null() || n > 64 { Vec::new() } else { (0..n).map(|i| args.add(i).read_unaligned()).collect() };
+    let console_types = real::world_draw_trace_enabled().then(|| list.iter().map(|a| a[0]).collect::<Vec<u32>>());
     for a in list.iter_mut() {
         if a[0] == XBOX_ARG_DISPATCH_X {
             a[0] = D3D12_INDIRECT_ARGUMENT_TYPE_DISPATCH.0 as u32;
@@ -1003,6 +1004,18 @@ pub(super) unsafe extern "system" fn create_command_signature_x(this: *mut c_voi
     if hr >= 0 && !ppv.is_null() && needs_root {
         super::bind::note_root_changing_signature(*ppv as usize);
     }
+    if hr >= 0 && !ppv.is_null() && !(*ppv).is_null() && real::world_draw_trace_enabled() {
+        static SEEN: Mutex<Vec<usize>> = Mutex::new(Vec::new());
+        let sig = *ppv as usize;
+        let mut seen = SEEN.lock().unwrap();
+        if seen.len() < 16 && !seen.contains(&sig) {
+            seen.push(sig);
+            drop(seen);
+            let stride = u32::from_le_bytes(pc[..4].try_into().unwrap());
+            let types: Vec<u32> = list.iter().map(|a| a[0]).collect();
+            crate::xlog_info!("world draw trace: signature {sig:#x} stride={stride} console_argument_types={console_types:?} pc_argument_types={types:?} root_changing={needs_root}");
+        }
+    }
     hr
 }
 
diff --git a/crates/xcl/src/hle/d3d12x/real.rs b/crates/xcl/src/hle/d3d12x/real.rs
index c5b1960..97102e9 100644
--- a/crates/xcl/src/hle/d3d12x/real.rs
+++ b/crates/xcl/src/hle/d3d12x/real.rs
@@ -3704,6 +3704,91 @@ pub fn two_pass_count() -> usize {
     TWO_PASS.lock().unwrap().as_ref().map_or(0, |m| m.len())
 }
 
+pub(super) fn world_draw_trace_enabled() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("XCL_WORLD_DRAW_TRACE").is_ok_and(|v| v == "1"))
+}
+
+fn trace_world_pso(pso: usize, event: &'static str, details: impl FnOnce() -> String) {
+    if !world_draw_trace_enabled() || pso == 0 {
+        return;
+    }
+    static SEEN: Mutex<Option<HashMap<usize, HashSet<&'static str>>>> = Mutex::new(None);
+    {
+        let mut g = SEEN.lock().unwrap();
+        let seen = g.get_or_insert_with(HashMap::new);
+        if !seen.contains_key(&pso) && seen.len() >= 16 {
+            return;
+        }
+        if !seen.entry(pso).or_default().insert(event) {
+            return;
+        }
+    }
+    crate::xlog_info!("world draw trace: {event} resolved PSO {pso:#x}: {}", details());
+}
+
+/// Metadata only, after the caller's existing resolve_wait; never resolve or wait here.
+pub(super) fn trace_world_command(pso: usize, event: &'static str, details: impl FnOnce() -> String) {
+    if !world_draw_trace_enabled() {
+        return;
+    }
+    let two_pass = TWO_PASS.lock().unwrap().as_ref().and_then(|m| m.get(&pso).cloned());
+    static CHECKS: AtomicU64 = AtomicU64::new(0);
+    static HITS: AtomicU64 = AtomicU64::new(0);
+    let hits = HITS.fetch_add(two_pass.is_some() as u64, Ordering::Relaxed) + two_pass.is_some() as u64;
+    let checks = CHECKS.fetch_add(1, Ordering::Relaxed) + 1;
+    if checks.is_power_of_two() || (two_pass.is_some() && hits.is_power_of_two()) {
+        crate::xlog_info!("world draw trace: command checks {checks}, two-pass hits {hits} (PSO detail cap 16)");
+    }
+    trace_world_pso(pso, event, || {
+        let class = if let Some(tp) = &two_pass {
+            format!("two-pass {} record_dwords={} mesh_groups_per_record={}", tp.kind, tp.record.record_dwords(), tp.mesh_groups_per_record)
+        } else if is_translated_graphics(pso) {
+            "translated graphics".into()
+        } else if is_translated_compute(pso) {
+            "translated compute".into()
+        } else {
+            "untranslated".into()
+        };
+        format!("{class}; {}", details())
+    });
+}
+
+fn trace_world_refused_stream(subs: &[(u32, &[u8])], base: usize, code: &[u8], sh: &crate::gpu::xbox::XboxShader) {
+    if !world_draw_trace_enabled() {
+        return;
+    }
+    let hash = crate::gpu::shader::fnv64(code);
+    static SEEN: Mutex<Vec<u64>> = Mutex::new(Vec::new());
+    {
+        let mut seen = SEEN.lock().unwrap();
+        if seen.len() >= 8 || seen.contains(&hash) {
+            return;
+        }
+        seen.push(hash);
+    }
+    let types: Vec<(u32, usize)> = subs.iter().take(64).map(|(ty, p)| {
+        let align = super::null::subobject_payload(*ty).map_or(4, |(_, a)| a);
+        (*ty, p.as_ptr() as usize - base - if align == 8 { 8 } else { 4 })
+    }).collect();
+    let slots: Vec<String> = [24u32, 25].into_iter().map(|ty| {
+        let found: Vec<String> = subs.iter().filter(|s| s.0 == ty).take(4).map(|(_, p)| {
+            let ptr = u64::from_le_bytes(p[..8].try_into().unwrap()) as usize;
+            let len = u64::from_le_bytes(p[8..16].try_into().unwrap()) as usize;
+            let status = if ptr == 0 { "null" } else if len == 0 { "empty" }
+                else if crate::gpu::shader::readable(ptr, len) { "readable" } else { "unreadable" };
+            format!("len={len} {status}")
+        }).collect();
+        format!("type{ty}={}", if found.is_empty() { "absent".into() } else { found.join(",") })
+    }).collect();
+    let variants: Vec<Vec<String>> = sh.fssm.iter().take(4).map(|f| f.stages.iter().take(4).map(|s| s.label()).collect()).collect();
+    let psv = crate::gpu::dxbc::psv(code).map(|p| (p.kind, p.numthreads, p.ms_topology, p.ms_max_vertices, p.ms_max_primitives));
+    crate::xlog_info!(
+        "world draw trace: refused MS {hash:016x}, embedded {} SM {}.{}, FSSM {variants:?}, PSV(kind,threads,topology,maxv,maxp)={psv:?}; stream types/offsets {types:?} ({} total); {}; E_INVALIDARG unchanged",
+        sh.stage, sh.shader_model.0, sh.shader_model.1, subs.len(), slots.join("; ")
+    );
+}
+
 /// A pipeline state stream being written: subobjects aligned as D3D12 expects
 /// (type, payload at 4 or 8, size rounded to 8).
 #[derive(Default)]
@@ -3833,9 +3918,12 @@ unsafe fn translated_mesh_stream(this: *mut c_void, desc: *const c_void, riid: *
     // from then on (a black screen every run); refused, it goes on to its menus. What it
     // expects of them is not known yet.
     if let (None, Some(a)) = (ms_slot, as_slot) {
-        if is_console(a) && crate::gpu::xbox::parse(a).is_some_and(|sh| sh.stage == "MS") {
-            note_translation_error(format!("mesh pipeline with its MS {:016x} in the AS slot – refused", crate::gpu::shader::fnv64(a)));
-            return Some(E_INVALIDARG);
+        if is_console(a) {
+            if let Some(sh) = crate::gpu::xbox::parse(a).filter(|sh| sh.stage == "MS") {
+                trace_world_refused_stream(&subs, base, a, &sh);
+                note_translation_error(format!("mesh pipeline with its MS {:016x} in the AS slot – refused", crate::gpu::shader::fnv64(a)));
+                return Some(E_INVALIDARG);
+            }
         }
     }
     let ms = ms_slot?;
@@ -3888,7 +3976,11 @@ unsafe fn translated_mesh_stream(this: *mut c_void, desc: *const c_void, riid: *
             out.raw(*ty, payload, palign == 8);
         }
     }
-    Some(finish_two_pass(this, &out, tp, rs, "MS", riid, ppv))
+    let hr = finish_two_pass(this, &out, tp, rs, "MS", riid, ppv);
+    if hr >= 0 && !ppv.is_null() && !(*ppv).is_null() {
+        trace_world_pso(*ppv as usize, "created-two-pass", || format!("MS source {:016x}", crate::gpu::shader::fnv64(ms)));
+    }
+    Some(hr)
 }
 
 /// A graphics PSO with a console VS + GS: the GS pipeline in two passes, as a mesh pipeline
@@ -3959,7 +4051,11 @@ unsafe fn translated_gs_pso(this: *mut c_void, d: &D3D12_GRAPHICS_PIPELINE_STATE
     if d.Flags.0 != 0 {
         out.put(D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_FLAGS, &d.Flags);
     }
-    finish_two_pass(this, &out, tp, rs, "GS", riid, ppv)
+    let hr = finish_two_pass(this, &out, tp, rs, "GS", riid, ppv);
+    if hr >= 0 && !ppv.is_null() && !(*ppv).is_null() {
+        trace_world_pso(*ppv as usize, "created-two-pass", || format!("GS sources VS {:016x} GS {:016x}", crate::gpu::shader::fnv64(vs), crate::gpu::shader::fnv64(gs)));
+    }
+    hr
 }
 
