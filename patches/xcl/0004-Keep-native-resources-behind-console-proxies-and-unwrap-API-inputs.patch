+//! Translate console resource pointers only where a native API consumes them.
+use std::ffi::c_void;
+use std::mem::ManuallyDrop;
+use windows::Win32::Graphics::Direct3D12::*;
+use super::{native_proxy::native, real::{self, Kind}};
+use crate::util::HRESULT;
+
+pub(super) fn relevant(s: usize) -> bool { matches!(s, 8 | 9 | 15..=21 | 26 | 34 | 35 | 42 | 46 | 49..=51 | 54 | 55 | 59..=61 | 64 | 80) }
+
+pub(super) fn method(kind: Kind, s: usize) -> Option<usize> {
+    Some(match (kind, s) {
+        (Kind::Device, 18) => srv as usize,
+        (Kind::Device, 19) => uav as usize,
+        (Kind::Device, 20) => rtv as usize,
+        (Kind::Device, 21) => dsv as usize,
+        (Kind::Device, 34) => make_resident as usize,
+        (Kind::Device, 35) => evict as usize,
+        (Kind::Device, 42) => tiling as usize,
+        (Kind::Device, 46) => residency_priority as usize,
+        (Kind::CommandQueue, 8) => update_tiles as usize,
+        (Kind::CommandQueue, 9) => copy_tile_mappings as usize,
+        (Kind::CommandList | Kind::DmaList, 15) => copy_buffer as usize,
+        (Kind::CommandList | Kind::DmaList, 16) => copy_texture as usize,
+        (Kind::CommandList | Kind::DmaList, 17) => copy_resource as usize,
+        (Kind::CommandList | Kind::DmaList, 18) => copy_tiles as usize,
+        (Kind::CommandList | Kind::DmaList, 19) => resolve as usize,
+        (Kind::CommandList | Kind::DmaList, 26) => barriers as usize,
+        (Kind::CommandList | Kind::DmaList, 49) => clear_uint as usize,
+        (Kind::CommandList | Kind::DmaList, 50) => clear_float as usize,
+        (Kind::CommandList | Kind::DmaList, 51) => discard as usize,
+        (Kind::CommandList | Kind::DmaList, 54) => resolve_query as usize,
+        (Kind::CommandList | Kind::DmaList, 55) => predication as usize,
+        (Kind::CommandList | Kind::DmaList, 59) => indirect as usize,
+        (Kind::CommandList | Kind::DmaList, 60) => atomic_uint as usize,
+        (Kind::CommandList | Kind::DmaList, 61) => atomic_uint64 as usize,
+        (Kind::CommandList | Kind::DmaList, 64) => resolve_region as usize,
+        (Kind::CommandList | Kind::DmaList, 80) => enhanced_barriers as usize,
+        _ => return None,
+    })
+}
+
+pub(super) unsafe fn objects(p: *const *mut c_void, n: u32) -> Vec<*mut c_void> {
+    if p.is_null() { return Vec::new(); }
+    std::slice::from_raw_parts(p, n as usize).iter().map(|&p| native(p)).collect()
+}
+
+macro_rules! forward {
+    ($name:ident, $slot:expr, ($($arg:ident: $ty:ty),*) -> $result:ty, ($($value:expr),*)) => {
+        unsafe extern "system" fn $name(this: *mut c_void, $($arg: $ty),*) -> $result {
+            let f: unsafe extern "system" fn(*mut c_void, $($ty),*) -> $result = std::mem::transmute(real::raw_orig_fn(this, $slot));
+            f(this, $($value),*)
+        }
+    };
+}
+forward!(srv, 18, (r: *mut c_void, d: *const c_void, at: u64) -> (), (native(r), d, at));
+forward!(uav, 19, (r: *mut c_void, c: *mut c_void, d: *const c_void, at: u64) -> (), (native(r), native(c), d, at));
+forward!(rtv, 20, (r: *mut c_void, d: *const c_void, at: u64) -> (), (native(r), d, at));
+forward!(dsv, 21, (r: *mut c_void, d: *const c_void, at: u64) -> (), (native(r), d, at));
+forward!(tiling, 42, (r: *mut c_void, tiles: *mut u32, packed: *mut c_void, shape: *mut c_void, count: *mut u32, first: u32, out: *mut c_void) -> (), (native(r), tiles, packed, shape, count, first, out));
+forward!(update_tiles, 8, (r: *mut c_void, n: u32, coords: *const c_void, sizes: *const c_void, heap: *mut c_void, ranges: u32, flags: *const c_void, offsets: *const u32, counts: *const u32, mapping_flags: u32) -> (), (native(r), n, coords, sizes, heap, ranges, flags, offsets, counts, mapping_flags));
+forward!(copy_tile_mappings, 9, (dst: *mut c_void, dc: *const c_void, src: *mut c_void, sc: *const c_void, size: *const c_void, flags: u32) -> (), (native(dst), dc, native(src), sc, size, flags));
+forward!(copy_buffer, 15, (dst: *mut c_void, doff: u64, src: *mut c_void, soff: u64, size: u64) -> (), (native(dst), doff, native(src), soff, size));
+forward!(copy_resource, 17, (dst: *mut c_void, src: *mut c_void) -> (), (native(dst), native(src)));
+forward!(copy_tiles, 18, (r: *mut c_void, coord: *const c_void, size: *const c_void, buffer: *mut c_void, offset: u64, flags: u32) -> (), (native(r), coord, size, native(buffer), offset, flags));
+forward!(resolve, 19, (dst: *mut c_void, ds: u32, src: *mut c_void, ss: u32, format: u32) -> (), (native(dst), ds, native(src), ss, format));
+forward!(clear_uint, 49, (gpu: u64, cpu: u64, r: *mut c_void, values: *const u32, n: u32, rects: *const c_void) -> (), (gpu, cpu, native(r), values, n, rects));
+forward!(clear_float, 50, (gpu: u64, cpu: u64, r: *mut c_void, values: *const f32, n: u32, rects: *const c_void) -> (), (gpu, cpu, native(r), values, n, rects));
+forward!(discard, 51, (r: *mut c_void, region: *const c_void) -> (), (native(r), region));
+forward!(resolve_query, 54, (heap: *mut c_void, ty: u32, first: u32, n: u32, dst: *mut c_void, offset: u64) -> (), (heap, ty, first, n, native(dst), offset));
+forward!(predication, 55, (r: *mut c_void, offset: u64, op: u32) -> (), (native(r), offset, op));
+forward!(indirect, 59, (signature: *mut c_void, n: u32, arguments: *mut c_void, offset: u64, count: *mut c_void, count_offset: u64) -> (), (signature, n, native(arguments), offset, native(count), count_offset));
+forward!(resolve_region, 64, (dst: *mut c_void, ds: u32, x: u32, y: u32, src: *mut c_void, ss: u32, rect: *const c_void, format: u32, mode: u32) -> (), (native(dst), ds, x, y, native(src), ss, rect, format, mode));
+
+macro_rules! object_array {
+    ($name:ident, $slot:expr) => {
+        unsafe extern "system" fn $name(this: *mut c_void, n: u32, p: *const *mut c_void) -> HRESULT {
+            let f: unsafe extern "system" fn(*mut c_void, u32, *const *mut c_void) -> HRESULT = std::mem::transmute(real::raw_orig_fn(this, $slot));
+            let mapped = objects(p, n);
+            f(this, n, if p.is_null() { p } else { mapped.as_ptr() })
+        }
+    };
+}
+object_array!(make_resident, 34);
+object_array!(evict, 35);
+unsafe extern "system" fn residency_priority(this: *mut c_void, n: u32, p: *const *mut c_void, priorities: *const u32) -> HRESULT {
+    let f: unsafe extern "system" fn(*mut c_void, u32, *const *mut c_void, *const u32) -> HRESULT = std::mem::transmute(real::raw_orig_fn(this, 46));
+    let mapped = objects(p, n);
+    f(this, n, if p.is_null() { p } else { mapped.as_ptr() }, priorities)
+}
+
+unsafe fn copy_location(p: *const D3D12_TEXTURE_COPY_LOCATION) -> Option<ManuallyDrop<D3D12_TEXTURE_COPY_LOCATION>> {
+    if p.is_null() { return None; }
+    let mut copy = ManuallyDrop::new(p.read());
+    let r = &mut copy.pResource as *mut _ as *mut *mut c_void;
+    *r = native(*r);
+    Some(copy)
+}
+unsafe extern "system" fn copy_texture(this: *mut c_void, dst: *const D3D12_TEXTURE_COPY_LOCATION, x: u32, y: u32, z: u32, src: *const D3D12_TEXTURE_COPY_LOCATION, region: *const D3D12_BOX) {
+    let f: unsafe extern "system" fn(*mut c_void, *const D3D12_TEXTURE_COPY_LOCATION, u32, u32, u32, *const D3D12_TEXTURE_COPY_LOCATION, *const D3D12_BOX) = std::mem::transmute(real::raw_orig_fn(this, 16));
+    let d = copy_location(dst); let s = copy_location(src);
+    f(this, d.as_ref().map_or(dst, |p| &**p), x, y, z, s.as_ref().map_or(src, |p| &**p), region)
+}
+unsafe extern "system" fn barriers(this: *mut c_void, n: u32, p: *const D3D12_RESOURCE_BARRIER) {
+    let f: unsafe extern "system" fn(*mut c_void, u32, *const D3D12_RESOURCE_BARRIER) = std::mem::transmute(real::raw_orig_fn(this, 26));
+    if p.is_null() { return f(this, n, p); }
+    let mut mapped: Vec<ManuallyDrop<D3D12_RESOURCE_BARRIER>> = (0..n as usize).map(|i| ManuallyDrop::new(p.add(i).read())).collect();
+    for b in &mut mapped {
+        match b.Type {
+            D3D12_RESOURCE_BARRIER_TYPE_TRANSITION => { let p = &mut (*b.Anonymous.Transition).pResource as *mut _ as *mut *mut c_void; *p = native(*p); }
+            D3D12_RESOURCE_BARRIER_TYPE_ALIASING => {
+                let a = &mut b.Anonymous.Aliasing;
+                let p = &mut a.pResourceBefore as *mut _ as *mut *mut c_void; *p = native(*p);
+                let p = &mut a.pResourceAfter as *mut _ as *mut *mut c_void; *p = native(*p);
+            }
+            D3D12_RESOURCE_BARRIER_TYPE_UAV => { let p = &mut (*b.Anonymous.UAV).pResource as *mut _ as *mut *mut c_void; *p = native(*p); }
+            _ => {}
+        }
+    }
+    f(this, n, mapped.as_ptr() as _)
+}
+macro_rules! atomic {
+    ($name:ident, $slot:expr) => {
+        unsafe extern "system" fn $name(this: *mut c_void, dst: *mut c_void, doff: u64, src: *mut c_void, soff: u64, n: u32, dependencies: *const *mut c_void, ranges: *const c_void) {
+            let f: unsafe extern "system" fn(*mut c_void, *mut c_void, u64, *mut c_void, u64, u32, *const *mut c_void, *const c_void) = std::mem::transmute(real::raw_orig_fn(this, $slot));
+            let mapped = objects(dependencies, n);
+            f(this, native(dst), doff, native(src), soff, n, if dependencies.is_null() { dependencies } else { mapped.as_ptr() }, ranges)
+        }
+    };
+}
+atomic!(atomic_uint, 60);
+atomic!(atomic_uint64, 61);
+
+unsafe extern "system" fn enhanced_barriers(this: *mut c_void, n: u32, groups: *const D3D12_BARRIER_GROUP) {
+    let f: unsafe extern "system" fn(*mut c_void, u32, *const D3D12_BARRIER_GROUP) = std::mem::transmute(real::raw_orig_fn(this, 80));
+    if groups.is_null() { return f(this, n, groups); }
+    let mut copies: Vec<D3D12_BARRIER_GROUP> = std::slice::from_raw_parts(groups, n as usize).to_vec();
+    let mut textures: Vec<Vec<ManuallyDrop<D3D12_TEXTURE_BARRIER>>> = Vec::new();
+    let mut buffers: Vec<Vec<ManuallyDrop<D3D12_BUFFER_BARRIER>>> = Vec::new();
+    for g in &mut copies {
+        match g.Type {
+            D3D12_BARRIER_TYPE_TEXTURE if !g.Anonymous.pTextureBarriers.is_null() => {
+                let p = g.Anonymous.pTextureBarriers;
+                let mut rows: Vec<_> = (0..g.NumBarriers as usize).map(|i| ManuallyDrop::new(p.add(i).read())).collect();
+                for r in &mut rows { let p = &mut r.pResource as *mut _ as *mut *mut c_void; *p = native(*p); }
+                g.Anonymous.pTextureBarriers = rows.as_ptr() as _; textures.push(rows);
+            }
+            D3D12_BARRIER_TYPE_BUFFER if !g.Anonymous.pBufferBarriers.is_null() => {
+                let p = g.Anonymous.pBufferBarriers;
+                let mut rows: Vec<_> = (0..g.NumBarriers as usize).map(|i| ManuallyDrop::new(p.add(i).read())).collect();
+                for r in &mut rows { let p = &mut r.pResource as *mut _ as *mut *mut c_void; *p = native(*p); }
+                g.Anonymous.pBufferBarriers = rows.as_ptr() as _; buffers.push(rows);
+            }
+            _ => {}
+        }
+    }
+    f(this, n, copies.as_ptr())
+}
