From abbae09c88b7606071cd34610b9990e3c4838f0c Mon Sep 17 00:00:00 2001
From: doromiert <doromiert@gmail.com>
Date: Tue, 24 Nov 2026 03:26:49 +0100
Subject: [PATCH] Add opt-in observed XG copy argument layout

---
 crates/xcl/src/hle/xg.rs | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/crates/xcl/src/hle/xg.rs b/crates/xcl/src/hle/xg.rs
index 5f86409..e750845 100644
--- a/crates/xcl/src/hle/xg.rs
+++ b/crates/xcl/src/hle/xg.rs
@@ -492,7 +492,7 @@ fn vtbl() -> &'static [usize] {
             get_texel_offset as usize,
             not_implemented as usize,
             copy_into as usize,
-            copy_from as usize,
+            if std::env::var("XCL_XG_COPY_FLAGS").as_deref() == Ok("1") { copy_from_flags as usize } else { copy_from as usize },
             get_resource_tiling as usize,
         ];
         for i in v.len()..12 {
@@ -694,6 +694,18 @@ unsafe extern "system" fn copy_into(p: *mut c_void, dst: *mut u8, plane: u32, su
 }
 
 /// the level's place in `src` (the whole resource) → rows of `dst` (`row_pitch` apart)
+/// Observed newer caller layout: an extra DWORD precedes the source pointer.
+/// Its nonzero semantics are unknown; retain the legacy ABI unless explicitly selected.
+unsafe extern "system" fn copy_from_flags(p: *mut c_void, dst: *mut u8, plane: u32, sub: u32, extra: u32, src: *const u8, row_pitch: u32, slice_pitch: u32) -> HRESULT {
+    static N: AtomicU32 = AtomicU32::new(0);
+    if N.fetch_add(1, Ordering::Relaxed) < 8 {
+        crate::xlog_info!("XG CopyFromSubresource newer ABI: extra {extra:#x}, plane {plane}, subresource {sub}, destination {dst:p}, source {src:p}, row pitch {row_pitch}, slice pitch {slice_pitch}");
+    }
+    if extra != 0 { return E_NOTIMPL; }
+    copy_from(p, dst, plane, sub, src, row_pitch, slice_pitch)
+}
+
+/// Legacy seven-argument copy layout.
 unsafe extern "system" fn copy_from(p: *mut c_void, dst: *mut u8, plane: u32, sub: u32, src: *const u8, row_pitch: u32, slice_pitch: u32) -> HRESULT {
     let Some((t, at, i, k)) = subresource(tex(p), plane, sub).filter(|_| !dst.is_null() && !src.is_null()) else { return E_INVALIDARG };
     let m = t.chain.levels[i];
-- 
