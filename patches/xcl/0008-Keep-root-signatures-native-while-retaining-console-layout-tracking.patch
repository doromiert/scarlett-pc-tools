From c15c29d4b4705e5aa317416f0cb4935901861943 Mon Sep 17 00:00:00 2001
From: doromiert <doromiert@gmail.com>
Date: Mon, 23 Nov 2026 22:35:08 +0100
Subject: [PATCH] Keep root signatures native while retaining console layout
 tracking

---
 crates/xcl/src/hle/d3d12x/real.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/xcl/src/hle/d3d12x/real.rs b/crates/xcl/src/hle/d3d12x/real.rs
index 5e99e0d..1b7d3f6 100644
--- a/crates/xcl/src/hle/d3d12x/real.rs
+++ b/crates/xcl/src/hle/d3d12x/real.rs
@@ -4190,7 +4190,7 @@ unsafe extern "system" fn dev_create_root_signature(this: *mut c_void, mask: u32
         }
     }
     if hr >= 0 && !ppv.is_null() && !(*ppv).is_null() {
-        adopt(*ppv, Kind::RootSignature);
+        // Root signatures have no console vtable extensions; native APIs require their identity.
         if !blob.is_null() {
             super::console_list::note_root_signature(*ppv as usize, std::slice::from_raw_parts(blob as *const u8, len));
         }
-- 
