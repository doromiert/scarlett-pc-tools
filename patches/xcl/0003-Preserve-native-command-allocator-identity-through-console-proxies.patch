+//! Native objects whose vtable identity the backend checks must stay untouched.
+use std::collections::HashMap;
+use std::ffi::c_void;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::sync::{Mutex, OnceLock};
+use windows::core::{Interface, IUnknown, GUID};
+use windows::Win32::Graphics::Direct3D12::*;
+use crate::util::{HRESULT, E_NOINTERFACE};
+
+#[derive(Clone, Copy, PartialEq)]
+pub(super) enum Kind { Fence, Allocator }
+
+#[repr(C)]
+struct Proxy {
+    vtbl: *const usize,
+    refs: AtomicU32,
+    native: *mut c_void,
+    kind: Kind,
+}
+
+static PROXIES: Mutex<Option<HashMap<usize, usize>>> = Mutex::new(None);
+
+/// Unwrap a console proxy at native API boundaries; PC-only objects pass through.
+pub(super) fn native(fence: *mut c_void) -> *mut c_void {
+    PROXIES.lock().unwrap_or_else(|e| e.into_inner()).as_ref()
+        .and_then(|m| m.get(&(fence as usize))).copied().unwrap_or(fence as usize) as *mut c_void
+}
+
+/// Take ownership of the reference returned by a native creator.
+pub(super) unsafe fn wrap(native: *mut c_void, kind: Kind) -> *mut c_void {
+    static V: OnceLock<[usize; 13]> = OnceLock::new();
+    let fence_vtbl = V.get_or_init(|| [
+        query_interface as usize, add_ref as usize, release as usize,
+        get_private_data as usize, set_private_data as usize, set_private_data_interface as usize,
+        set_name as usize, get_device as usize, get_completed_value as usize,
+        set_event_on_completion as usize, signal as usize, get_creation_flags as usize,
+        super::fence_x::completed_value_address as usize,
+    ]);
+    static A: OnceLock<[usize; 9]> = OnceLock::new();
+    let allocator_vtbl = A.get_or_init(|| [
+        query_interface as usize, add_ref as usize, release as usize,
+        get_private_data as usize, set_private_data as usize, set_private_data_interface as usize,
+        set_name as usize, get_device as usize, reset_allocator as usize,
+    ]);
+    let vtbl = if kind == Kind::Fence { fence_vtbl.as_ptr() } else { allocator_vtbl.as_ptr() };
+    let p = Box::into_raw(Box::new(Proxy { vtbl, refs: AtomicU32::new(1), native, kind })) as *mut c_void;
+    PROXIES.lock().unwrap_or_else(|e| e.into_inner()).get_or_insert_with(HashMap::new).insert(p as usize, native as usize);
+    p
+}
+
+unsafe fn proxy<'a>(p: *mut c_void) -> &'a Proxy { &*(p as *const Proxy) }
+
+unsafe extern "system" fn query_interface(p: *mut c_void, iid: *const GUID, out: *mut *mut c_void) -> HRESULT {
+    if out.is_null() || iid.is_null() { return 0x8000_4003u32 as i32; }
+    *out = std::ptr::null_mut();
+    let base = [IUnknown::IID, ID3D12Object::IID, ID3D12DeviceChild::IID, ID3D12Pageable::IID].contains(&*iid);
+    let specific = match proxy(p).kind {
+        Kind::Fence => [ID3D12Fence::IID, ID3D12Fence1::IID].contains(&*iid),
+        Kind::Allocator => *iid == ID3D12CommandAllocator::IID,
+    };
+    if !base && !specific {
+        return E_NOINTERFACE;
+    }
+    let f = IUnknown::from_raw_borrowed(&proxy(p).native).unwrap();
+    let mut queried = std::ptr::null_mut();
+    let hr = f.query(iid, &mut queried).0;
+    if hr >= 0 {
+        drop(IUnknown::from_raw(queried));
+        add_ref(p);
+        *out = p;
+    }
+    hr
+}
+
+unsafe extern "system" fn add_ref(p: *mut c_void) -> u32 {
+    proxy(p).refs.fetch_add(1, Ordering::Relaxed) + 1
+}
+
+unsafe extern "system" fn release(p: *mut c_void) -> u32 {
+    let refs = proxy(p).refs.fetch_sub(1, Ordering::AcqRel) - 1;
+    if refs == 0 {
+        PROXIES.lock().unwrap_or_else(|e| e.into_inner()).as_mut().unwrap().remove(&(p as usize));
+        let obj = Box::from_raw(p as *mut Proxy);
+        if obj.kind == Kind::Allocator { super::list_x::on_allocator_release(p as usize); }
+        drop(IUnknown::from_raw(obj.native));
+    }
+    refs
+}
+
+macro_rules! forward {
+    ($name:ident, $slot:expr, ($($arg:ident: $ty:ty),*) -> $result:ty) => {
+        unsafe extern "system" fn $name(p: *mut c_void, $($arg: $ty),*) -> $result {
+            let obj = proxy(p).native;
+            let f: unsafe extern "system" fn(*mut c_void, $($ty),*) -> $result =
+                std::mem::transmute(*(*(obj as *const *const usize)).add($slot));
+            f(obj, $($arg),*)
+        }
+    };
+}
+
+forward!(get_private_data, 3, (iid: *const GUID, size: *mut u32, data: *mut c_void) -> HRESULT);
+forward!(set_private_data, 4, (iid: *const GUID, size: u32, data: *const c_void) -> HRESULT);
+forward!(set_private_data_interface, 5, (iid: *const GUID, data: *mut c_void) -> HRESULT);
+forward!(set_name, 6, (name: *const u16) -> HRESULT);
+forward!(get_device, 7, (iid: *const GUID, out: *mut *mut c_void) -> HRESULT);
+forward!(get_completed_value, 8, () -> u64);
+forward!(set_event_on_completion, 9, (value: u64, event: *mut c_void) -> HRESULT);
+forward!(native_signal, 10, (value: u64) -> HRESULT);
+
+unsafe extern "system" fn get_creation_flags(p: *mut c_void) -> u32 {
+    ID3D12Fence::from_raw_borrowed(&proxy(p).native).unwrap().cast::<ID3D12Fence1>()
+        .map(|f| f.GetCreationFlags().0 as u32).unwrap_or(0)
+}
+
+unsafe extern "system" fn signal(p: *mut c_void, value: u64) -> HRESULT {
+    let hr = native_signal(p, value);
+    if hr >= 0 { super::fence_x::note_cpu_signal(p as usize); }
+    hr
+}
+
+forward!(native_reset_allocator, 8, () -> HRESULT);
+
+unsafe extern "system" fn reset_allocator(p: *mut c_void) -> HRESULT {
+    let hr = native_reset_allocator(p);
+    if hr >= 0 { super::console_list::allocator_reset(p); }
+    hr
+}
